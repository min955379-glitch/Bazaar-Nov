{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated shopper profile stored in Firestore",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the owner" },
        "displayName": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "description": "User email address" },
        "photoUrl": { "type": "string", "description": "Optional Google profile photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["userId", "displayName", "email", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized store administrator record",
      "type": "object",
      "properties": {
        "adminId": { "type": "string", "description": "Firebase Auth UID of the admin" },
        "email": { "type": "string", "description": "Admin email" },
        "grantedBy": { "type": "string", "description": "UID or email of granting bootstrapped admin" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of grant" }
      },
      "required": ["adminId", "email", "grantedBy", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Storefront catalog product managed by admins",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "category": { "type": "string", "enum": ["Electronics", "Fashion", "Home", "Accessories"], "description": "Product category" },
        "priceCents": { "type": "integer", "description": "Unit price in cents" },
        "stockCount": { "type": "integer", "description": "Available inventory units" },
        "imageKey": { "type": "string", "description": "Preset drawable key or image URL" },
        "active": { "type": "boolean", "description": "Whether product is visible in storefront" },
        "featured": { "type": "boolean", "description": "Whether product is highlighted in featured row" },
        "createdBy": { "type": "string", "description": "Admin UID that created the product" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["title", "description", "category", "priceCents", "stockCount", "imageKey", "active", "featured", "createdBy", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Shopping cart item scoped under user",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "description": "Referenced product document ID" },
        "title": { "type": "string", "description": "Product title snapshot" },
        "priceCents": { "type": "integer", "description": "Unit price in cents" },
        "imageKey": { "type": "string", "description": "Product image key or URL" },
        "quantity": { "type": "integer", "description": "Quantity in cart (1..50)" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of update" }
      },
      "required": ["productId", "title", "priceCents", "imageKey", "quantity", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order synced with Firestore",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of buyer" },
        "customerName": { "type": "string", "description": "Recipient full name" },
        "customerEmail": { "type": "string", "description": "Recipient email" },
        "shippingAddress": { "type": "string", "description": "Delivery address" },
        "customerPhone": { "type": "string", "description": "Contact phone number" },
        "paymentMethod": { "type": "string", "enum": ["Cash on Delivery", "Card on Delivery", "Digital Wallet"], "description": "Payment option" },
        "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED"], "description": "Order fulfillment status" },
        "totalCents": { "type": "integer", "description": "Order grand total in cents" },
        "itemCount": { "type": "integer", "description": "Total units ordered" },
        "items": { "type": "array", "description": "Bounded list of order line items" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["userId", "customerName", "customerEmail", "shippingAddress", "customerPhone", "paymentMethod", "status", "totalCents", "itemCount", "items", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated shopper profile documents"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Store administrators authorized for live catalog and order management"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Live shopping catalog products"
    },
    "/users/{userId}/cart/{productId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "User-scoped persistent shopping cart items"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders viewable by buyer and manageable by admins"
    }
  }
}
