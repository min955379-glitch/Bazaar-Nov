rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED HELPERS ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'abdulmanan304000@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // --- VALIDATION BLUEPRINTS ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500));
    }

    function isValidAdminRecord(data) {
      return data.adminId is string && isValidId(data.adminId) &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
             data.grantedBy is string && data.grantedBy.size() >= 1 && data.grantedBy.size() <= 160;
    }

    function isValidProduct(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
             data.description is string && data.description.size() >= 2 && data.description.size() <= 1000 &&
             data.category in ['Electronics', 'Fashion', 'Home', 'Accessories'] &&
             data.priceCents is int && data.priceCents >= 1 && data.priceCents <= 100000000 &&
             data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 100000 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 500 &&
             data.active is bool &&
             data.featured is bool &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128;
    }

    function isValidCartItem(data) {
      return data.productId is string && isValidId(data.productId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.priceCents is int && data.priceCents >= 1 && data.priceCents <= 100000000 &&
             data.imageKey is string && data.imageKey.size() >= 1 && data.imageKey.size() <= 500 &&
             data.quantity is int && data.quantity >= 1 && data.quantity <= 50;
    }

    function isValidOrder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
             data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 160 &&
             data.shippingAddress is string && data.shippingAddress.size() >= 5 && data.shippingAddress.size() <= 300 &&
             data.customerPhone is string && data.customerPhone.size() >= 5 && data.customerPhone.size() <= 30 &&
             data.paymentMethod in ['Cash on Delivery', 'Card on Delivery', 'Digital Wallet'] &&
             data.status in ['PENDING', 'PROCESSING', 'SHIPPED', 'DELIVERED', 'CANCELLED'] &&
             data.totalCents is int && data.totalCents >= 1 && data.totalCents <= 500000000 &&
             data.itemCount is int && data.itemCount >= 1 && data.itemCount <= 200 &&
             data.items is list && data.items.size() >= 1 && data.items.size() <= 50 &&
             data.items[0] is map;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /cart/{productId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(productId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         request.auth.uid == userId &&
                         incoming().productId == productId &&
                         incoming().keys().hasAll(['productId', 'title', 'priceCents', 'imageKey', 'quantity', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['productId', 'title', 'priceCents', 'imageKey', 'quantity', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         isValidCartItem(incoming()) &&
                         exists(/databases/$(database)/documents/products/$(productId));

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(productId) &&
                         request.auth.uid == userId &&
                         isValidCartItem(incoming()) &&
                         incoming().productId == existing().productId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'priceCents', 'imageKey', 'quantity', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(productId) && request.auth.uid == userId;
      }
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();

      allow create: if isBootstrappedAdmin() &&
                       isValidId(adminId) &&
                       incoming().adminId == adminId &&
                       incoming().keys().hasAll(['adminId', 'email', 'grantedBy', 'createdAt']) &&
                       incoming().keys().hasOnly(['adminId', 'email', 'grantedBy', 'createdAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidAdminRecord(incoming());

      allow update: if isBootstrappedAdmin() &&
                       isValidId(adminId) &&
                       isValidAdminRecord(incoming()) &&
                       incoming().adminId == existing().adminId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'grantedBy']);

      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /products/{productId} {
      allow get: if isSignedIn() && isValidId(productId) && (resource.data.active == true || isAdmin());
      allow list: if isSignedIn() && (resource.data.active == true || isAdmin());

      allow create: if isAdmin() &&
                       isValidId(productId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll(['title', 'description', 'category', 'priceCents', 'stockCount', 'imageKey', 'active', 'featured', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['title', 'description', 'category', 'priceCents', 'stockCount', 'imageKey', 'active', 'featured', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidProduct(incoming());

      allow update: if isSignedIn() &&
                       isValidId(productId) &&
                       isValidProduct(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'priceCents', 'stockCount', 'imageKey', 'active', 'featured', 'updatedAt'])) ||
                         (existing().active == true &&
                          incoming().stockCount >= 0 &&
                          incoming().stockCount < existing().stockCount &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['stockCount', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(orderId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll(['userId', 'customerName', 'customerEmail', 'shippingAddress', 'customerPhone', 'paymentMethod', 'status', 'totalCents', 'itemCount', 'items', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'customerName', 'customerEmail', 'shippingAddress', 'customerPhone', 'paymentMethod', 'status', 'totalCents', 'itemCount', 'items', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       isValidOrder(incoming());

      allow update: if isSignedIn() &&
                       isValidId(orderId) &&
                       isValidOrder(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
                         (existing().userId == request.auth.uid &&
                          existing().status == 'PENDING' &&
                          incoming().status == 'CANCELLED' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );

      allow delete: if isAdmin() && isValidId(orderId);
    }
  }
}
